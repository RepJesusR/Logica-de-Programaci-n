# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-32chars-minimum
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zuvra:zuvra@localhost:5432/zuvra
DATABASE_URL_SYNC=postgresql://zuvra:zuvra@localhost:5432/zuvra

# ── UNIGIS MAPI SOAP ─────────────────────────────────────────────────
# Credenciales del cliente piloto (por tenant en DB, esto es el default dev)
UNIGIS_WSDL_URL=https://<cliente>.unigis.net/services/mapi/service.asmx?WSDL
UNIGIS_API_KEY=your-api-key-here
UNIGIS_LOGIN=admin
UNIGIS_PASSWORD=password

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── SendGrid (Email) ──────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
SENDGRID_FROM_EMAIL=notificaciones@zuvra.io
SENDGRID_FROM_NAME=Zuvra Compliance

# ── Scheduler ────────────────────────────────────────────────────────
# Intervalo de sync en minutos
SYNC_INTERVAL_MINUTES=30
# Hora de ejecución del job diario de notificaciones (HH:MM, UTC)
NOTIFY_JOB_HOUR=08
NOTIFY_JOB_MINUTE=00

# ── Autenticación API ────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZUVRA_API_KEY=generate-a-strong-random-key-here

# ── Frontend ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
